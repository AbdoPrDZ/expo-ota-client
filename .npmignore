# What npm must not publish. What ships: dist/ (minified JS + .d.ts), android/,
# app.plugin.js, expo-module.config.json, README.md, LICENSE.

# Readable sources: dist/ is built from them by `npm run build` (prepublishOnly).
# Anchored with a leading slash: a bare `src/` would also drop android/src/.
/src/
/plugin/
/cli/
/scripts/
/tsconfig.build.json

# Example app (has its own node_modules, native build and release APKs)
example/

# Agent / editor tooling
.agents/
skills-lock.json
.vscode/
.idea/
.claude/

# Dependencies and lockfiles
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock*

# Tests
**/__tests__/
**/*.test.js
**/*.test.ts
**/*.test.tsx

# Build output and native caches
android/build/
android/.gradle/
android/.cxx/
android/local.properties
.kotlin/
coverage/
*.tgz

# CLI output and signing keys
release/
keys/
certs/

# Repo / dev config
.git/
.github/
.gitignore
.npmignore
tsconfig.json

# Misc
*.log
.DS_Store
Thumbs.db
